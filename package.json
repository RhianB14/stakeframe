{
  "name": "stakeframe",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "build:types": "tsc -b",
    "build": "pnpm build:types && pnpm --filter @stakeframe/web build",
    "typecheck": "pnpm build:types && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "test": "pnpm build:types && vitest run --config vitest.config.ts",
    "test:integration": "pnpm build:types && vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "api:spec": "pnpm build:types && node scripts/openapi.mjs --write",
    "api:spec:check": "pnpm build:types && node scripts/openapi.mjs --check",
    "images:check": "node scripts/check-runtime-images.mjs",
    "deployment:check": "node scripts/deployment-check.mjs",
    "deployment:rehearse": "node scripts/deployment-rehearsal.mjs",
    "recovery:test-safety": "node --test scripts/recovery/safety.test.mjs",
    "recovery:drill": "pnpm recovery:test-safety && node scripts/recovery-drill.mjs",
    "recovery:r2": "node scripts/recovery-drill.mjs --r2",
    "telegram:test": "node --test scripts/telegram/owner.test.mjs",
    "telegram:setup": "node scripts/telegram/setup.mjs",
    "ai:test": "node --test scripts/ai/probe.test.mjs scripts/ai/opencode-go.test.mjs",
    "ai:setup": "node scripts/ai/setup.mjs",
    "local:init": "node scripts/local-env.mjs",
    "local:up": "docker compose --env-file .env.local -f compose.local.yml up -d --build --wait",
    "local:down": "docker compose --env-file .env.local -f compose.local.yml down",
    "local:status": "docker compose --env-file .env.local -f compose.local.yml ps",
    "local:test-db": "pnpm build:types && node --env-file=.env.local scripts/test-local-db.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.0.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.13",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "openapi-types": "12.1.3",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
