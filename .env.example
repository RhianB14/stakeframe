# Exemplo de variáveis de ambiente — somente placeholders.
# Copie para .env e preencha com valores reais. NUNCA commite o .env real.
# Segredos reais ficam fora do repositório (gerenciador de segredos /
# ambiente de execução). Este arquivo não deve conter valores que funcionem.

# ---- Ambiente ----
NODE_ENV=development
LOG_LEVEL=info

# ---- Banco de dados (planejado — M1) ----
DATABASE_URL=postgresql://usuario:senha@localhost:5432/stakeframe

# ---- API ----
API_PORT=3000
SESSION_SECRET=troque-por-um-valor-gerado-aleatorio

# ---- Autenticação Google (planejado) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTHORIZED_GOOGLE_EMAIL=

# ---- Telegram bot (planejado) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# ---- OmniRoute / IA (planejado) ----
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=

# ---- Cloudflare R2 (planejado) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_ATTACHMENTS=
R2_BUCKET_BACKUPS=
