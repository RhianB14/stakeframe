# Exemplo de variáveis de ambiente — somente placeholders.
# Compose local: use pnpm local:init, que gera .env.local automaticamente.
# As integrações abaixo são planejadas. NUNCA commite um .env real.
# Segredos reais ficam fora do repositório (gerenciador de segredos /
# ambiente de execução). Este arquivo não deve conter valores que funcionem.

# ---- Ambiente ----
NODE_ENV=development
STAKEFRAME_RUNTIME=local
LOG_LEVEL=info

# ---- Banco de dados (API executada fora do Docker; somente placeholder) ----
DATABASE_URL=postgresql://usuario:senha@localhost:5432/stakeframe

# ---- API ----
API_PORT=3000
API_HOST=127.0.0.1
AUTH_ENABLED=false
APP_ORIGIN=http://127.0.0.1:8088
BETTER_AUTH_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres

# ---- Autenticação Google (código pronto; ativação depende de configuração) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTHORIZED_GOOGLE_EMAIL=
AUTHORIZED_GOOGLE_SUB=

# ---- Telegram bot (desativado até configurar integração) ----
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_OWNER_USER_ID=

# ---- IA via OpenRouter (ativação explícita; decisão D018) ----
AI_ENABLED=false
AI_PROVIDER=openrouter
OPENROUTER_API_KEY_FILE=
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_MAX_OUTPUT_TOKENS=2048
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_TIMEOUT_MS=60000
OPENROUTER_ALLOW_FALLBACKS=false

# ---- Anexos privados no R2 (adaptador pronto; ativação separada) ----
R2_ATTACHMENTS_ENABLED=false
R2_ACCOUNT_ID=
R2_ATTACHMENTS_ACCESS_KEY_ID_FILE=
R2_ATTACHMENTS_SECRET_ACCESS_KEY_FILE=
R2_ATTACHMENTS_BUCKET=stakeframe-attachments
# A credencial de backups é separada e não atende ao adaptador de anexos.
R2_BUCKET_BACKUPS=

# ---- Buscas de eventos (ativação separada; correção de datas sempre revisada) ----
THESPORTSDB_ENABLED=false
TAVILY_ENABLED=false
TAVILY_API_KEY_FILE=
# TheSportsDB: chave pública 123, até 60/dia e 1.500/mês.
# Tavily: apenas basic, até 20/dia e 600/mês; não habilitar cobrança automática.
