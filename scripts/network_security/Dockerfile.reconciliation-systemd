FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y python3 systemd systemd-sysv && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY scripts/network_security /workspace/scripts/network_security
ENV STK_DISPOSABLE_SYSTEMD=1
CMD ["python3", "-m", "unittest", "scripts.network_security.integration_reconciliation", "-v"]
