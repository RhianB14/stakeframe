{
    admin off
    auto_https off
}

:8080 {
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -X-Frame-Options
        -Content-Security-Policy
    }
    handle /api/* {
        reverse_proxy api:3000
    }
    handle /health/* {
        reverse_proxy api:3000
    }
    handle /miniapp* {
        header {
            Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self'; img-src 'self' data:; connect-src 'self' https://telegram.org; base-uri 'none'; frame-ancestors https://web.telegram.org https://*.telegram.org; form-action 'none'"
        }
        root * /srv
        try_files {path} /index.html
        file_server
    }
    handle {
        header {
            X-Frame-Options DENY
            Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self'; img-src 'self' data:; connect-src 'self' https://telegram.org; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        }
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
