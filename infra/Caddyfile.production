{
    admin off
    http_port 8080
    https_port 8443
    persist_config off
    # Empty in production; the disposable rehearsal mounts a Pebble override here.
    import /etc/caddy/global.d/*
}

https://{$APP_DOMAIN} {
    import /etc/caddy/tls.conf
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Strict-Transport-Security "max-age=31536000"
        -X-Frame-Options
        -Content-Security-Policy
        -Server
    }
    handle /api/* {
        reverse_proxy api:3000
    }
    handle /health/* {
        reverse_proxy api:3000
    }
    handle /miniapp* {
        header {
            Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self'; img-src 'self' data:; connect-src 'self' https://telegram.org; base-uri 'none'; frame-ancestors https://web.telegram.org https://*.telegram.org; form-action 'none'"
        }
        root * /srv
        try_files {path} /index.html
        file_server
    }
    handle {
        header {
            X-Frame-Options DENY
            Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self'; img-src 'self' data:; connect-src 'self' https://telegram.org; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        }
        root * /srv
        try_files {path} /index.html
        file_server
    }
}

http://127.0.0.1:9080 {
    bind 127.0.0.1
    respond /health/live "alive" 200
}
