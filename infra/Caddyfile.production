{
    admin off
    http_port 8080
    https_port 8443
    persist_config off
}

https://{$APP_DOMAIN} {
    import /etc/caddy/tls.conf
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Strict-Transport-Security "max-age=31536000"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        -Server
    }
    handle /api/* {
        reverse_proxy api:3000
    }
    handle /health/* {
        reverse_proxy api:3000
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}

http://127.0.0.1:9080 {
    bind 127.0.0.1
    respond /health/live "alive" 200
}
