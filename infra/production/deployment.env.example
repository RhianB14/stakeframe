# Copy outside the repository and replace every placeholder. Contains no secret values.
DEPLOYMENT_ID=replace-with-reviewed-release-id
SECRET_DIRECTORY=/etc/stakeframe/secrets
APP_DOMAIN=stakeframe.com.br
ACME_EMAIL=replace-with-operator-email
GOOGLE_CLIENT_ID=replace-with-production-oauth-client
AUTHORIZED_GOOGLE_EMAIL=replace-with-owner-email
AUTHORIZED_GOOGLE_SUB=replace-with-owner-subject
API_IMAGE=replace-with-reviewed-api-image@sha256:replace
WORKER_IMAGE=replace-with-reviewed-worker-image@sha256:replace
MIGRATE_IMAGE=replace-with-reviewed-migrate-image@sha256:replace
WEB_IMAGE=replace-with-reviewed-web-production-image@sha256:replace
