# Copy outside the repository and replace every placeholder. Contains no secret values.
# Stable installation identity; preserve across image updates and volume reuse.
DEPLOYMENT_ID=replace-with-reviewed-installation-id
SECRET_DIRECTORY=/etc/stakeframe/secrets
APP_DOMAIN=stakeframe.com.br
ACME_EMAIL=replace-with-operator-email
GOOGLE_CLIENT_ID=replace-with-production-oauth-client
AUTHORIZED_GOOGLE_EMAIL=replace-with-owner-email
AUTHORIZED_GOOGLE_SUB=replace-with-owner-subject
API_IMAGE=replace-with-reviewed-api-image@sha256:replace
WORKER_IMAGE=replace-with-reviewed-worker-image@sha256:replace
MIGRATE_IMAGE=replace-with-reviewed-migrate-image@sha256:replace
WEB_IMAGE=replace-with-reviewed-web-production-image@sha256:replace
# Required with compose.integrations.yml and compose.operations.yml.
OPERATIONS_IMAGE=replace-with-reviewed-operations-image@sha256:replace
R2_ACCOUNT_ID=replace-with-attachments-account-id
R2_ATTACHMENTS_BUCKET=replace-with-private-attachments-bucket
R2_BACKUP_ACCOUNT_ID=replace-with-backup-account-id
R2_BACKUP_BUCKET=replace-with-distinct-private-backup-bucket
# Set only in the explicitly authorized production activation.
BACKUP_CONFIRM=replace-after-backup-and-retention-authorization
# Optional compose.automatic-import.yml; use only after private corpus approval.
AUTOMATIC_IMPORT_POLICIES_FILE=/etc/stakeframe/automatic-import.json
