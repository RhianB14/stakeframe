  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "@stakeframe/shared": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10"
  }
}
